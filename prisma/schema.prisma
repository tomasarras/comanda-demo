// Comanda — fictional restaurant management demo (portfolio project).
// Full data model sketched up front so later phases (Órdenes, Ventas,
// Gastos, Caja) don't need destructive migrations; only Productos/Panel
// are wired up to UI in Phase 1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderType {
  SALON
  MOSTRADOR
  DELIVERY
}

enum OrderStatus {
  ABIERTA
  EN_COCINA
  LISTA
  ENVIANDO
  ENTREGADA
  PAGADA
  CANCELADA
}

enum DeliveryMode {
  RETIRA
  ENVIO
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  MERCADO_PAGO
}

enum CashMovementType {
  INGRESO
  EGRESO
  VENTA
}

// Fila única de configuración general del local (ej. costo de envío). Se
// lee/escribe siempre con id "singleton" — ver lib/settings.js.
model Settings {
  id          String   @id @default("singleton")
  deliveryFee Decimal  @default(0) @db.Decimal(10, 2)
  updatedAt   DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  cost        Decimal     @db.Decimal(10, 2)
  stock       Int         @default(0)
  available   Boolean     @default(true)
  imageUrl    String?
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Supplier {
  id        String    @id @default(cuid())
  name      String
  contact   String?
  phone     String?
  email     String?
  notes     String?
  expenses  Expense[]
  createdAt DateTime  @default(now())
}

model RestaurantTable {
  id           String        @id @default(cuid())
  number       Int           @unique
  capacity     Int           @default(2)
  posX         Float         @default(50)
  posY         Float         @default(50)
  orders       Order[]
  reservations Reservation[]
}

model Reservation {
  id           String          @id @default(cuid())
  tableId      String
  table        RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  customerName String
  phone        String?
  partySize    Int             @default(2)
  reservedFor  DateTime
  notes        String?
  createdAt    DateTime        @default(now())
}

// El id del rol es el mismo string que ROLES[].id en lib/roles.js (fuente
// de verdad de roles/permisos) — no hay un enum acá para no duplicarlo.
model Employee {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  role      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Order {
  id         String      @id @default(cuid())
  type       OrderType   @default(SALON)
  status     OrderStatus @default(ABIERTA)
  tableId    String?
  table      RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  waiterName String?
  customerName  String?
  customerPhone String?
  address       String?
  deliveryMode  DeliveryMode?
  deliveredBy   String?
  paid       Boolean     @default(false)
  items      OrderItem[]
  saleId     String?
  sale       Sale?       @relation(fields: [saleId], references: [id])
  deliveryFee Decimal    @default(0) @db.Decimal(10, 2)
  total      Decimal     @default(0) @db.Decimal(10, 2)
  createdAt  DateTime    @default(now())
  closedAt   DateTime?
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  notes     String?
}

model Sale {
  id            String        @id @default(cuid())
  orders        Order[]
  total         Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  cashierName   String?
  createdAt     DateTime      @default(now())
}

model Expense {
  id          String    @id @default(cuid())
  description String
  category    String
  amount      Decimal   @db.Decimal(10, 2)
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  createdAt   DateTime  @default(now())
}

model CashRegisterShift {
  id             String         @id @default(cuid())
  openedBy       String
  closedBy       String?
  openingAmount  Decimal        @db.Decimal(10, 2)
  closingAmount  Decimal?       @db.Decimal(10, 2)
  expectedAmount Decimal?       @db.Decimal(10, 2)
  difference     Decimal?       @db.Decimal(10, 2)
  movements      CashMovement[]
  openedAt       DateTime       @default(now())
  closedAt       DateTime?
}

model CashMovement {
  id          String            @id @default(cuid())
  shiftId     String
  shift       CashRegisterShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  type        CashMovementType
  amount      Decimal           @db.Decimal(10, 2)
  description String?
  createdAt   DateTime          @default(now())
}
